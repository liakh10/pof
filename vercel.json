{
  "cleanUrls": true,
  "functions": {
    "api/v1/index.js": {
      "maxDuration": 30,
      "includeFiles": "{sdk/dist/**,sdk/package.json,api/openapi.json,embed/svg.js,witness/*.js}"
    },
    "api/mcp.js": {
      "maxDuration": 30,
      "includeFiles": "{mcp/core.js,mcp/tools.js,api/v1/_core.js,api/v1/_lib.js,api/openapi.json,embed/svg.js,witness/*.js,sdk/dist/**,sdk/package.json}"
    },
    "api/bots.js": {
      "maxDuration": 30,
      "includeFiles": "{bots/*.js,bots/link.html,api/v1/_lib.js,sdk/dist/**,sdk/package.json}"
    },
    "api/attest/index.js": {
      "maxDuration": 30
    },
    "api/attest/log.js": {
      "maxDuration": 30
    },
    "api/relay/[fn].js": {
      "maxDuration": 60
    },
    "api/link/[fn].js": {
      "maxDuration": 30
    },
    "api/keeper/[fn].js": {
      "maxDuration": 60
    },
    "api/status/index.js": {
      "maxDuration": 30,
      "includeFiles": "{sdk/dist/**,sdk/package.json,verifier/dist/BUILD.json}"
    },
    "api/status/history.js": {
      "maxDuration": 30,
      "includeFiles": "{sdk/dist/**,sdk/package.json,verifier/dist/BUILD.json}"
    },
    "api/status/sample.js": {
      "maxDuration": 60,
      "includeFiles": "{sdk/dist/**,sdk/package.json,verifier/dist/BUILD.json}"
    },
    "api/spr/[method].js": {
      "maxDuration": 60,
      "includeFiles": "client/server/spr-proxy.js"
    },
    "api/witness.js": {
      "maxDuration": 60,
      "includeFiles": "{witness/*.js,sdk/dist/**,sdk/package.json}"
    },
    "api/rpc.js": {
      "maxDuration": 30
    },
    "api/card.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{ui/seal.js,api/_card/*.ttf,node_modules/@resvg/resvg-wasm/**,api/v1/_lib.js,sdk/dist/**,sdk/package.json}"
    },
    "api/share.js": {
      "maxDuration": 15,
      "includeFiles": "{c.html,api/v1/_lib.js,sdk/dist/**,sdk/package.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/spr-prover/:path*",
      "destination": "/api/spr/prover?path=:path*"
    },
    {
      "source": "/v1",
      "destination": "/api/v1?path="
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/bots/:fn",
      "destination": "/api/bots?fn=:fn"
    },
    {
      "source": "/link",
      "destination": "/api/bots?fn=link"
    },
    {
      "source": "/api/link",
      "destination": "/api/link/verify"
    },
    {
      "source": "/c/:subject",
      "destination": "/api/share?subject=:subject"
    },
    {
      "source": "/rooms/:room",
      "destination": "/room?room=:room"
    },
    {
      "source": "/api/card/:subject",
      "destination": "/api/card?subject=:subject"
    }
  ],
  "buildCommand": "npm --prefix verifier ci && npm --prefix verifier run build:verify",
  "headers": [
    {
      "source": "/((?!embed/|lab/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://d3gbdb0egjwcw9.cloudfront.net; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/ui/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "outputDirectory": "."
}
