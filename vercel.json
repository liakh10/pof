{
  "cleanUrls": true,
  "functions": {
    "api/v1/index.js": {
      "maxDuration": 30,
      "includeFiles": "{sdk/dist/**,sdk/package.json,api/openapi.json}"
    },
    "api/mcp.js": {
      "maxDuration": 30,
      "includeFiles": "{mcp/core.js,mcp/tools.js,api/v1/_core.js,api/v1/_lib.js,api/openapi.json,sdk/dist/**,sdk/package.json}"
    },
    "api/bots.js": {
      "maxDuration": 30,
      "includeFiles": "{bots/*.js,bots/link.html,api/v1/_lib.js,sdk/dist/**,sdk/package.json}"
    }
  },
  "rewrites": [
    {
      "source": "/v1",
      "destination": "/api/v1?path="
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/bots/:fn",
      "destination": "/api/bots?fn=:fn"
    },
    {
      "source": "/link",
      "destination": "/api/bots?fn=link"
    }
  ]
}
