{
  "name": "@pof/sdk",
  "version": "0.1.0",
  "description": "Proof of Funds SDK: read certificates straight from Solana, hash subjects, verify transparency-log proofs, build CPI accounts for require_certificate and pof_gate.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/liakh10/pof.git",
    "directory": "sdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/",
    "sync-idl": "node scripts/sync-idl.mjs",
    "pack": "npm run build && npm pack --pack-destination release"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4",
    "typescript": "5.9.3"
  }
}
